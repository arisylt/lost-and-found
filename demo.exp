#!/usr/bin/expect -f

proc wait {ms} {
  set ::tick 0
  after $ms {set ::tick 1}
  vwait ::tick
}

proc hold {secs} {
  wait [expr {int($secs * 1000)}]
}

proc s {text {pause 0.8}} {
  foreach c [split $text ""] {
    send -- $c
    wait [expr {int(45 + rand() * 85)}]
  }
  wait 200
  send -- "\r"
  hold $pause
}

proc submitBlockedClaim {itemName itemNumber} {
  s 2
  s $itemName
  s 0
  s 0
  s $itemNumber
  s "detail salah"
  s ""
}

set project [file normalize [file dirname [info script]]]
set binary "$project/lostfound"
# Always rebuild, otherwise a stale binary silently demos old behaviour.
puts "Membangun lostfound..."
set cflags [string trim [exec mysql_config --cflags]]
set libs [string trim [exec mysql_config --libs]]
set buildCommand [concat g++ -std=c++11 -Wall -Wextra $cflags \
                      "$project/src/main.cpp" -o $binary $libs -lcrypto]
if {[catch {exec {*}$buildCommand} message]} {
  puts stderr $message
  exit 1
}

# The demo writes to the configured database (default: lostfound) and replaces
# its contents, so point LF_DB_NAME at a spare database when in doubt.
if {[info exists ::env(LF_DB_NAME)]} {
  puts "Database demo: $::env(LF_DB_NAME)"
} else {
  puts "Database demo: lostfound (default)"
}

# shortcut: keeps data only in a temporary workspace; use a spare LF_DB_NAME to retain a demo.
set workspace "/tmp/lostfound-demo-[pid]"
file delete -force $workspace
file mkdir $workspace
spawn sh -c "cd '$workspace' && exec '$binary'"
log_user 1
hold 2

set today [clock format [clock seconds] -format "%Y-%m-%d"]

# Student A registers and deposits a found item, with one wrong keypad PIN.
s 1
s 240001
s "Demo Mahasiswa"
s 1
s "demo@example.test"
s 081200000001
s demo123
s ""
s 2
s 240001
s demo123
s 1
s "Kunci Demo"
s 5
s 4
s $today
s "Kunci logam dengan beberapa anak kunci"
s "Gantungan merah"
expect {
  -re {Kode titip: ([0-9]+)} {set depositCode $expect_out(1,string)}
  timeout {
    puts stderr "Demo gagal menunggu output demo."
    exit 1
  }
}
hold 1
s 000000
s $depositCode
s 1
s ""
s 4

# Student B registers, claims that item, and picks it up after one wrong PIN.
s 1
s 240002
s "Demo Pengklaim"
s 2
s "pengklaim@example.test"
s 081200000002
s demo123
s ""
s 2
s 240002
s demo123
s 2
s "Kunci Demo"
s 0
s 0
expect {
  -re {\[([0-9]+)\] Kunci Demo} {set claimNumber $expect_out(1,string)}
  timeout {
    puts stderr "Demo gagal menunggu output demo."
    exit 1
  }
}
s $claimNumber
s "Gantungan merah"
expect {
  -re {Kode ambil berlaku 24 jam: ([0-9]+)} {set pickupCode $expect_out(1,string)}
  timeout {
    puts stderr "Demo gagal menunggu output demo."
    exit 1
  }
}
hold 1
s 000000
s $pickupCode
s 1
s ""
s 3
s ""
s 4

# Student A deposits a second item and reports a locker problem instead.
s 2
s 240001
s demo123
s 1
s "Loker Rusak Demo"
s 5
s 4
s $today
s "Kunci yang tertinggal di loker"
s "Stiker biru"
expect {
  -re {Kode titip: ([0-9]+)} {set anomalyCode $expect_out(1,string)}
  timeout {
    puts stderr "Demo gagal menunggu output demo."
    exit 1
  }
}
hold 1
s $anomalyCode
s 3
s ""

# A third item stays available so another student can block a claim on it.
s 1
s "Dompet Demo"
s 3
s 4
s $today
s "Dompet kulit dengan kartu"
s "Ada kartu pelajar"
expect {
  -re {Kode titip: ([0-9]+)} {set walletCode $expect_out(1,string)}
  timeout {
    puts stderr "Demo gagal menunggu output demo."
    exit 1
  }
}
hold 1
s $walletCode
s 1
s ""
s 4

# Student C blocks that claim with three wrong secret details.
s 1
s 240003
s "Demo Terblokir"
s 3
s "terblokir@example.test"
s 081200000003
s demo123
s ""
s 2
s 240003
s demo123
s 2
s "Dompet Demo"
s 0
s 0
expect {
  -re {\[([0-9]+)\] Dompet Demo} {set walletNumber $expect_out(1,string)}
  timeout {
    puts stderr "Demo gagal menunggu output demo."
    exit 1
  }
}
# The search is already on screen for the first attempt; the next two repeat it.
s $walletNumber
s "detail salah"
s ""
submitBlockedClaim "Dompet Demo" $walletNumber
submitBlockedClaim "Dompet Demo" $walletNumber
s 4

# Admin approves the blocked claim, marks the anomalous locker defective, then
# shows the locker states and the newest locker events.
s 2
s admin
s admin123
s 1
expect {
  -re {\[([0-9]+)\] Loker Rusak Demo} {set anomalyNumber $expect_out(1,string)}
  timeout {
    puts stderr "Demo gagal menunggu output demo."
    exit 1
  }
}
s ""
s 3
expect {
  -re {\[([0-9]+)\] Dompet Demo} { set blockedClaimNumber $expect_out(1,string) }
  timeout {
    puts stderr "Demo gagal menunggu output demo."
    exit 1
  }
}
s $blockedClaimNumber
s 1
expect {
  -re {Kode ambil baru: ([0-9]+)} {set approvedCode $expect_out(1,string)}
  timeout {
    puts stderr "Demo gagal menunggu output demo."
    exit 1
  }
}
s ""
s 2
s $anomalyNumber
s 2
s ""
s 4
s ""
s 5
s ""
s 6
s 3
expect eof
