# Shared Expect helpers for the flowchart demos. Each script gets its own MySQL
# database created from schema.sql; the plain text files are gone.

set testDir [file normalize [file dirname [info script]]]
set project [file normalize "$testDir/.."]
set binary "$project/build/lostfound-test"
set ::dbName ""

# Extra arguments for the mariadb client, e.g. "--socket=/tmp/x.sock -u root".
proc dbClientArgs {} {
  if {[info exists ::env(LF_DB_ADMIN_ARGS)]} {
    return $::env(LF_DB_ADMIN_ARGS)
  }
  return {}
}

# Runs one SQL statement without selecting a database.
proc dbAdmin {statement} {
  return [exec mariadb {*}[dbClientArgs] -N -e $statement 2>@1]
}

# Runs one SQL statement inside this script's database.
proc dbQuery {statement} {
  global dbName
  return [exec mariadb {*}[dbClientArgs] -N $dbName -e $statement 2>@1]
}

# Fails the script when a scalar query does not return the expected text.
proc expectSql {statement expected} {
  set actual [string trim [dbQuery $statement]]
  if {$actual != $expected} {
    puts stderr "Query '$statement' menghasilkan '$actual', seharusnya '$expected'."
    exit 1
  }
}

# Creates the database for this run from schema.sql, once per script.
proc prepareDatabase {} {
  global project dbName

  if {$dbName != ""} {
    return $dbName
  }
  if {[catch {dbAdmin "SELECT 1"} message]} {
    puts stderr "Butuh server MySQL: $message"
    exit 1
  }

  # One fixed database per script: a leftover from an interrupted run is simply
  # dropped again on the next start, and restart scenarios reuse the same data.
  global argv0
  set dbName "lostfound_test_[string map {- _ . _} [file rootname [file tail $argv0]]]"
  dbAdmin "DROP DATABASE IF EXISTS $dbName"
  dbAdmin "CREATE DATABASE $dbName CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"

  # schema.sql targets the database name "lostfound"; drop those statements.
  set handle [open "$project/schema.sql" r]
  set schema [read $handle]
  close $handle
  regsub -all {CREATE DATABASE[^;]*;} $schema "" schema
  regsub -all {USE [^;]*;} $schema "" schema
  set scratch "/tmp/lostfound-schema-[pid].sql"
  set out [open $scratch w]
  puts -nonewline $out $schema
  close $out
  set in [open $scratch r]
  if {[catch {exec mariadb {*}[dbClientArgs] $dbName <@$in} message]} {
    close $in
    puts stderr "schema.sql gagal dimuat: $message"
    exit 1
  }
  close $in
  file delete -force $scratch

  set ::env(LF_DB_NAME) $dbName
  return $dbName
}

proc sendLine {text {pause 120}} {
  send -- "$text\r"
  after $pause
}

proc expectText {pattern} {
  expect {
    -re $pattern { return }
    timeout {
      puts stderr "Expected output not found: $pattern"
      exit 1
    }
    eof {
      puts stderr "Application ended before expected output: $pattern"
      exit 1
    }
  }
}

proc prepareTest {} {
  global project binary

  file mkdir "$project/build"
  if {[catch {exec mysql_config --cflags} message]} {
    puts stderr "mysql_config tidak ditemukan: $message"
    exit 1
  }
  set cflags [string trim [exec mysql_config --cflags]]
  set libs [string trim [exec mysql_config --libs]]
  set buildCommand [concat g++ -std=c++11 -Wall -Wextra $cflags \
                        $project/src/main.cpp -o $binary $libs]
  if {[catch {exec {*}$buildCommand} message]} {
    puts stderr $message
    exit 1
  }
}

# Creates an empty workspace and returns its path for restart scenarios.
proc newWorkspace {} {
  set workspace "/tmp/lostfound-test-[pid]-[clock microseconds]"
  file delete -force $workspace
  file mkdir $workspace
  return $workspace
}

proc startAppIn {workspace} {
  global binary spawn_id

  prepareDatabase
  spawn sh -c "cd '$workspace' && exec '$binary'"
  log_user 1
  after 250
}

proc startApp {} {
  startAppIn [newWorkspace]
}

proc registerStudent {nim fullName major email phone password} {
  sendLine 1
  sendLine $nim
  sendLine $fullName
  sendLine $major
  sendLine $email
  sendLine $phone
  sendLine $password
  expectText {Registrasi berhasil! Silakan login\.}
  sendLine ""
}

proc loginStudent {nim password} {
  sendLine 2
  sendLine $nim
  sendLine $password
  expectText "Selamat datang, $nim!"
}

proc logoutStudent {} {
  sendLine 4
  expectText {MAIN MENU}
}

proc exitApp {} {
  sendLine 3 0
  expect eof
}

proc depositItem {name category locationNo description secret sensor} {
  sendLine 1
  sendLine $name
  sendLine $category
  sendLine $locationNo
  sendLine [clock format [clock seconds] -format "%Y-%m-%d"]
  sendLine $description
  sendLine $secret

  expect {
    -re {Kode titip: ([0-9]+)} { set depositCode $expect_out(1,string) }
    timeout {
      puts stderr "Kode titip tidak ditampilkan."
      exit 1
    }
    eof {
      puts stderr "Aplikasi berhenti sebelum kode titip ditampilkan."
      exit 1
    }
  }

  sendLine 000000
  expectText {Kode salah\. Percobaan tersisa: 2}
  sendLine $depositCode
  expectText {\[OK\] Pintu loker terbuka\.}
  sendLine $sensor
  if {$sensor == 1} {
    expectText {\[OK\] Penitipan selesai\. Barang sekarang dapat dicari\.}
  } else {
    expectText {Anomali tercatat; loker dikunci untuk verifikasi admin\.}
  }
  sendLine ""
}
