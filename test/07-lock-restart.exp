#!/usr/bin/expect -f
# An account lock must survive a program restart, so users.txt has to keep
# the lock expiry timestamp and not only the locked flag.
source [file join [file dirname [info script]] lib.exp]

prepareTest

set suffix [pid]
set nim "71$suffix"
set password "test123"
set workspace [newWorkspace]
startAppIn $workspace

registerStudent $nim "Test Kunci Restart $suffix" 1 "restart-$suffix@example.test" "081$suffix" $password

for {set attempt 1} {$attempt <= 3} {incr attempt} {
  sendLine 2
  sendLine $nim
  sendLine "salah123"
  if {$attempt < 3} {
    expectText {Password salah\.}
  } else {
    expectText {Akun terkunci selama 15 menit karena terlalu banyak percobaan gagal\.}
  }
  sendLine ""
}
exitApp

# Reopen the same data folder: the correct password must still be refused.
startAppIn $workspace
sendLine 2
sendLine $nim
sendLine $password
expectText {Akun terkunci selama 15 menit karena terlalu banyak percobaan gagal\.}
sendLine ""

# The stored role column must also survive the restart, so admin keeps its menu.
loginStudent admin admin123
expectText {MENU ADMIN}
sendLine 5
expectText {MAIN MENU}
exitApp
