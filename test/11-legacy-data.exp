#!/usr/bin/expect -f
# Data files written by older versions (5 and 9 column users, 8 and 16 column
# items, 3 column claims, no locker_logs.txt) must still load and work.
source [file join [file dirname [info script]] lib.exp]

# Fails the script when a stored file does not contain the expected pattern.
proc expectFileMatch {path pattern} {
  set handle [open $path r]
  set content [read $handle]
  close $handle
  if {![regexp -line $pattern $content]} {
    puts stderr "Pola tidak ditemukan di $path: $pattern\nIsi:\n$content"
    exit 1
  }
}

proc writeLegacyFiles {workspace} {
  foreach {name content} [list \
    users.txt "Azhri|Azhri123|081234567890|0|0\nArya|Arya123|089876543210|0|0\nadmin|admin123|0000000000|0|0|Administrator|||Admin\n" \
    found_items.txt "0|Payung Hitam|Aksesori|Kantin Utama|2026-10-25|Payung lipat warna hitam|Ada stiker bintang|Tersedia\n1|Dompet Kulit Coklat|Dompet|Parkiran Fakultas|2026-10-26|Dompet berisi kartu identitas|Ada kartu pelajar di selipan|Tersedia|demo/dompet-coklat.jpg|1||0|-1||0|0\n" \
    claims.txt "1|0|3\n" \
    lost_reports.txt "0|Kunci Motor|Kunci|Kantin Utama|2026-10-20|Hilang setelah kuliah\n" \
    lockers.txt "0\n0\n0\n0\n0\n0\n0\n0\n0\n"] {
    set handle [open [file join $workspace $name] w]
    puts -nonewline $handle $content
    close $handle
  }
}

prepareTest
set workspace [newWorkspace]
writeLegacyFiles $workspace
startAppIn $workspace

set password "Azhri123"
set item "Dompet Kulit Coklat"

# A five column legacy account still logs in and keeps its old claim block.
loginStudent Azhri $password
sendLine 2
sendLine $item
sendLine 0
sendLine 0
expect {
  -re [format {\[([0-9]+)\] %s} $item] { set itemNumber $expect_out(1,string) }
  timeout {
    puts stderr "Barang dari file lama tidak muncul dalam pencarian."
    exit 1
  }
}
sendLine $itemNumber
expectText {Kamu sudah mencapai batas percobaan klaim; hubungi admin\.}
sendLine ""
logoutStudent

# The legacy blocked claim is still visible to admin and can be approved.
loginStudent admin admin123
sendLine 3
expect {
  -re [format {\[([0-9]+)\] %s} $item] { set blockedClaimNumber $expect_out(1,string) }
  timeout {
    puts stderr "Klaim terblokir dari file lama tidak muncul di menu admin."
    exit 1
  }
}
sendLine $blockedClaimNumber
sendLine 1
expect {
  -re {Kode ambil baru: ([0-9]+)} { set pickupCode $expect_out(1,string) }
  timeout {
    puts stderr "Kode ambil baru tidak ditampilkan."
    exit 1
  }
}
sendLine ""
sendLine 6
expectText {MAIN MENU}

# The approved pickup finishes on the legacy item, then shows up in history.
loginStudent Azhri $password
sendLine 2
expectText {KLAIM DISETUJUI BELUM DIAMBIL}
sendLine 2
sendLine $itemNumber
sendLine $pickupCode
expectText {\[OK\] Pintu loker terbuka\.}
sendLine 1
expectText {\[OK\] Pengambilan selesai\. Loker kembali tersedia\.}
sendLine ""
sendLine 3
expectText {Status   : Selesai}
sendLine ""
logoutStudent
exitApp

# Every file is rewritten in the current format, with the reserved column empty.
expectFileMatch [file join $workspace users.txt] {^admin\|admin123\|0000000000\|0\|0\|Administrator\|\|\|Admin\|0$}
expectFileMatch [file join $workspace claims.txt] {^1\|0\|0\|Selesai\|[0-9]+\|[0-9]+$}
expectFileMatch [file join $workspace found_items.txt] {^1\|Dompet Kulit Coklat\|Dompet\|Parkiran Fakultas\|2026-10-26\|Dompet berisi kartu identitas\|Ada kartu pelajar di selipan\|Sudah Diambil\|\|}
expectFileMatch [file join $workspace locker_logs.txt] {PINTU_AMBIL}
expectFileMatch [file join $workspace locker_logs.txt] {AMBIL_OK}
