#!/usr/bin/expect -f
# The locker event log must record the deposit and pickup events in order and
# must still be there after the program is restarted.
source [file join [file dirname [info script]] lib.exp]

prepareTest

set suffix [pid]
set finder "81$suffix"
set claimant "82$suffix"
set password "test123"
set item "Test Log Loker $suffix"
set secret "detail log $suffix"
set workspace [newWorkspace]
startAppIn $workspace

# Deposit one item all the way to "Tersedia".
registerStudent $finder "Test Penemu Log $suffix" 1 "log-finder-$suffix@example.test" "091$suffix" $password
loginStudent $finder $password
depositItem $item 3 "Parkiran Test" "Barang untuk test log" $secret 1
logoutStudent

# Another student claims it and finishes the pickup.
registerStudent $claimant "Test Pengklaim Log $suffix" 2 "log-claimant-$suffix@example.test" "092$suffix" $password
loginStudent $claimant $password
sendLine 2
sendLine $item
sendLine 0
sendLine ""
expect {
  -re [format {\[([0-9]+)\] %s} $item] { set itemNumber $expect_out(1,string) }
  timeout {
    puts stderr "Barang test tidak muncul dalam hasil pencarian."
    exit 1
  }
}
sendLine $itemNumber
sendLine $secret
expect {
  -re {Kode ambil berlaku 24 jam: ([0-9]+)} { set pickupCode $expect_out(1,string) }
  timeout {
    puts stderr "Kode ambil tidak ditampilkan."
    exit 1
  }
}
sendLine $pickupCode
expectText {\[OK\] Pintu loker terbuka\.}
sendLine 1
expectText {\[OK\] Pengambilan selesai\. Loker kembali tersedia\.}
sendLine ""
logoutStudent
exitApp

# The admin log shows the newest event first, down to the reservation.
startAppIn $workspace
loginStudent admin admin123
sendLine 5
expectText {LOG LOKER \(20 TERBARU\)}
expectText {AMBIL_OK}
expectText {PINTU_AMBIL}
expectText {TITIP_OK}
expectText {PINTU_TITIP}
expectText {RESERVASI}
sendLine ""
sendLine 6
expectText {MAIN MENU}
exitApp

# A second restart proves locker_logs.txt is read back.
startAppIn $workspace
loginStudent admin admin123
sendLine 5
expectText {AMBIL_OK}
expectText {RESERVASI}
sendLine ""
sendLine 6
expectText {MAIN MENU}
exitApp
