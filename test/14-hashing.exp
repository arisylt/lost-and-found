#!/usr/bin/expect -f
# Passwords and locker access codes are stored as SHA-256 digests (RAT:
# users.password_hash and access_codes.code_hash), while a typed value still
# works and legacy plaintext rows are upgraded on first successful login.
source [file join [file dirname [info script]] lib.exp]

set suffix [expr {[pid] % 100000}]

proc findRow {workspace path needle} {
  set handle [open [file join $workspace $path] r]
  set index 0
  set found -1
  while {[gets $handle line] >= 0} {
    if {[string first $needle $line] >= 0} { set found $index }
    incr index
  }
  close $handle
  return $found
}

proc rowField {workspace path row field} {
  set handle [open [file join $workspace $path] r]
  set index 0
  set line ""
  while {[gets $handle current] >= 0} {
    if {$index == $row} { set line $current }
    incr index
  }
  close $handle
  if {$line == ""} { return "" }
  return [lindex [split $line "|"] $field]
}

proc expectFileMatch {path pattern} {
  set handle [open $path r]
  set content [read $handle]
  close $handle
  if {![regexp -line $pattern $content]} {
    puts stderr "Pola tidak ditemukan di $path: $pattern\nIsi:\n$content"
    exit 1
  }
}

prepareTest
set workspace [newWorkspace]

# A legacy plaintext account and one already hashed account are both valid.
set handle [open [file join $workspace users.txt] w]
puts -nonewline $handle "Lama|lama1234|081200000001|0|0|Akun Lama|Informatika|lama@example.test|Mahasiswa\n"
close $handle
startAppIn $workspace

set password "test123"
set nim "94$suffix"
registerStudent $nim "Test Hash $suffix" 2 "hash-$suffix@example.test" "092$suffix" $password

# The stored password is a digest and never the typed password.
expectFileMatch [file join $workspace users.txt] [format {^%s\|[0-9a-f]{64}\|092%s\|} $nim $suffix]
sendLine 2
sendLine $nim
sendLine $password
expectText "Selamat datang, $nim!"
logoutStudent
exitApp

# The legacy plaintext account still logs in and is upgraded in place.
startAppIn $workspace
sendLine 2
sendLine Lama
sendLine lama1234
expectText {Selamat datang, Lama!}
logoutStudent
exitApp
expectFileMatch [file join $workspace users.txt] {^Lama\|[0-9a-f]{64}\|}

# Access codes: only the digest is stored, the printed code still opens the door.
startAppIn $workspace
loginStudent $nim $password
sendLine 1
sendLine "Barang Kode Hash $suffix"
sendLine 4
sendLine 3
sendLine [clock format [clock seconds] -format "%Y-%m-%d"]
sendLine "Barang untuk test hash kode"
sendLine "rahasia kode $suffix"
expect {
  -re {Kode titip: ([0-9]+)} { set depositCode $expect_out(1,string) }
  timeout {
    puts stderr "Kode titip tidak ditampilkan."
    exit 1
  }
}
if {[string length $depositCode] != 6} {
  puts stderr "Kode yang ditampilkan bukan kode asli: $depositCode"
  exit 1
}

# While the reservation is live, column 11 holds a digest, never the code.
set row [findRow $workspace found_items.txt "Barang Kode Hash $suffix"]
set stored [rowField $workspace found_items.txt $row 10]
if {![regexp {^[0-9a-f]{64}$} $stored]} {
  puts stderr "Kode titip tidak disimpan sebagai digest: $stored"
  exit 1
}
if {$stored == $depositCode} {
  puts stderr "Kode titip tersimpan apa adanya."
  exit 1
}

sendLine $depositCode
expectText {\[OK\] Pintu loker terbuka\.}
sendLine 1
expectText {\[OK\] Penitipan selesai\.}
sendLine ""
logoutStudent
exitApp

# A claim issues a pickup code the same way: digest on disk, code on screen.
set claimant "95$suffix"
startAppIn $workspace
registerStudent $claimant "Pengklaim Hash $suffix" 3 "hash-c-$suffix@example.test" "093$suffix" $password
loginStudent $claimant $password
sendLine 2
sendLine "Barang Kode Hash $suffix"
sendLine 0
sendLine 0
expect {
  -re [format {\[([0-9]+)\] %s} "Barang Kode Hash $suffix"] { set itemNumber $expect_out(1,string) }
  timeout {
    puts stderr "Barang test tidak muncul dalam hasil pencarian."
    exit 1
  }
}
sendLine $itemNumber
sendLine "rahasia kode $suffix"
expect {
  -re {Kode ambil berlaku 24 jam: ([0-9]+)} { set pickupCode $expect_out(1,string) }
  timeout {
    puts stderr "Kode ambil tidak ditampilkan."
    exit 1
  }
}
set storedPickup [rowField $workspace found_items.txt $row 13]
if {![regexp {^[0-9a-f]{64}$} $storedPickup]} {
  puts stderr "Kode ambil tidak disimpan sebagai digest: $storedPickup"
  exit 1
}
sendLine $pickupCode
expectText {\[OK\] Pintu loker terbuka\.}
sendLine 1
expectText {\[OK\] Pengambilan selesai\.}
sendLine ""
logoutStudent
exitApp
