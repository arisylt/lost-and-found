#!/usr/bin/expect -f
# The MySQL mirror (built with -DUSE_MYSQL) must copy the text file data into the
# schema from database.sql after every save, while the .txt files stay the
# source of truth. Skips with exit code 0 when no server or client is available.
#
# Environment (all optional):
#   LF_DB_HOST / LF_DB_PORT / LF_DB_USER / LF_DB_PASS  connection used by the app
#   LF_DB_NAME                                        scratch database to fill
#   LF_DB_ADMIN_ARGS                                  extra client args, e.g.
#                                                     "--socket=/tmp/maria.sock -u root"

set testDir [file normalize [file dirname [info script]]]
set project [file normalize "$testDir/.."]
set binary "$project/build/lostfound-mysql"
set database [expr {[info exists env(LF_DB_NAME)] ? $env(LF_DB_NAME) : "lostfound_test"}]

proc clientArgs {} {
  # Inside a proc the env array must be reached through its global name.
  set args {}
  if {[info exists ::env(LF_DB_ADMIN_ARGS)]} {
    set args $::env(LF_DB_ADMIN_ARGS)
  }
  return $args
}

# Runs one SQL statement inside the scratch database.
proc sql {statement} {
  global database
  return [exec mariadb {*}[clientArgs] -N $database -e $statement 2>@1]
}

# Runs one SQL statement without selecting a database (needed to create it).
proc sqlAdmin {statement} {
  return [exec mariadb {*}[clientArgs] -N -e $statement 2>@1]
}

proc skip {reason} {
  puts "SKIP: $reason"
  exit 0
}

# Optional dependency: client, server, and the MySQL headers.
if {[catch {exec mariadb --version}]} {
  skip "klien mariadb/mysql tidak tersedia"
}
if {[catch {exec mysql_config --cflags}]} {
  skip "mysql_config (header MySQL) tidak tersedia"
}
if {[catch {sqlAdmin "SELECT 1"}]} {
  skip "server MySQL tidak dapat dihubungi (set LF_DB_ADMIN_ARGS)"
}

if {[catch {sqlAdmin "DROP DATABASE IF EXISTS $database"} message]} {
  puts stderr $message
  exit 1
}
if {[catch {sqlAdmin "CREATE DATABASE $database CHARACTER SET utf8mb4"} message]} {
  puts stderr $message
  exit 1
}
# database.sql targets the database name "lostfound"; drop those statements so
# the suite can fill a scratch database instead.
set workspace "/tmp/lostfound-mysql-[pid]-[clock microseconds]"
file delete -force $workspace
file mkdir $workspace

set handle [open "$project/database.sql" r]
set schema [read $handle]
close $handle
regsub -all {CREATE DATABASE[^;]*;} $schema "" schema
regsub -all {USE [^;]*;} $schema "" schema
set schemaFile "$workspace/schema.sql"
set out [open $schemaFile w]
puts -nonewline $out $schema
close $out
set schemaIn [open $schemaFile r]
if {[catch {exec mariadb {*}[clientArgs] $database <@$schemaIn} message]} {
  close $schemaIn
  puts stderr "Skema database.sql gagal dimuat: $message"
  exit 1
}
close $schemaIn

# Build the same source with the mirror enabled.
set cflags [string trim [exec mysql_config --cflags]]
set libs [string trim [exec mysql_config --libs]]
set command [concat g++ -std=c++11 -Wall -Wextra -DUSE_MYSQL $cflags \
                $project/src/main.cpp -o $binary $libs]
if {[catch {exec {*}$command} message]} {
  puts stderr $message
  exit 1
}

# Fails the script when a stored count is not the expected number.
proc expectCount {table expected} {
  set actual [sql "SELECT COUNT(*) FROM $table"]
  if {[string trim $actual] != $expected} {
    puts stderr "Tabel $table berisi '$actual' baris, seharusnya $expected."
    exit 1
  }
}

# Fails the script when a scalar query does not return the expected value.
proc expectValue {query expected} {
  set actual [string trim [sql $query]]
  if {$actual != $expected} {
    puts stderr "Query '$query' menghasilkan '$actual', seharusnya '$expected'."
    exit 1
  }
}

proc sendLine {text {pause 150}} {
  send -- "$text\r"
  after $pause
}

proc expectText {pattern} {
  expect {
    -re $pattern { return }
    timeout {
      puts stderr "Output tidak ditemukan: $pattern"
      exit 1
    }
    eof {
      puts stderr "Aplikasi berhenti sebelum: $pattern"
      exit 1
    }
  }
}

spawn sh -c "cd '$workspace' && exec '$binary'"
log_user 1
after 250

set suffix [expr {[pid] % 100000}]
set finder "97$suffix"
set claimant "98$suffix"
set password "test123"
set item "Barang Mirror $suffix"
set secret "rahasia mirror $suffix"

# Finder deposits one item, so items, deposits, and logs get rows.
sendLine 1
sendLine $finder
sendLine "Penemu Mirror $suffix"
sendLine 1
sendLine "mirror-$suffix@example.test"
sendLine "081200000020"
sendLine $password
expectText {Registrasi berhasil}
sendLine ""
sendLine 2
sendLine $finder
sendLine $password
expectText "Selamat datang, $finder!"
sendLine 1
sendLine $item
sendLine 3
sendLine 2
sendLine [clock format [clock seconds] -format "%Y-%m-%d"]
sendLine "Barang untuk uji mirror"
sendLine $secret
expect {
  -re {Kode titip: ([0-9]+)} { set depositCode $expect_out(1,string) }
  timeout {
    puts stderr "Kode titip tidak ditampilkan."
    exit 1
  }
}
sendLine $depositCode
expectText {\[OK\] Pintu loker terbuka\.}
sendLine 1
expectText {\[OK\] Penitipan selesai\.}
sendLine ""

# The mirror already holds the item and its deposit cycle.
expectValue "SELECT COUNT(*) FROM items WHERE nama_barang = '$item'" 1
expectValue "SELECT status FROM items WHERE nama_barang = '$item'" "Tersedia"
expectValue "SELECT COUNT(*) FROM deposits WHERE id_item = (SELECT id_item FROM items WHERE nama_barang = '$item')" 1
expectValue "SELECT COUNT(*) FROM locker_event_logs WHERE keterangan = '$item'" 3

sendLine 4
expectText {MAIN MENU}

# A second student claims the item, so claims and access_codes get a row.
sendLine 1
sendLine $claimant
sendLine "Pengklaim Mirror $suffix"
sendLine 2
sendLine "mirror-c-$suffix@example.test"
sendLine "081200000021"
sendLine $password
expectText {Registrasi berhasil}
sendLine ""
sendLine 2
sendLine $claimant
sendLine $password
expectText "Selamat datang, $claimant!"
sendLine 2
sendLine $item
sendLine 0
sendLine 0
expect {
  -re [format {\[([0-9]+)\] %s} $item] { set itemNumber $expect_out(1,string) }
  timeout {
    puts stderr "Barang mirror tidak muncul dalam pencarian."
    exit 1
  }
}
sendLine $itemNumber
sendLine $secret
expect {
  -re {Kode ambil berlaku 24 jam: ([0-9]+)} { set pickupCode $expect_out(1,string) }
  timeout {
    puts stderr "Kode ambil tidak ditampilkan."
    exit 1
  }
}

# The claim is mirrored as APPROVED and the pickup code as an ACTIVE PICKUP row.
expectValue "SELECT status FROM claims WHERE nim_pengklaim = '$claimant'" "APPROVED"
expectValue "SELECT COUNT(*) FROM access_codes WHERE tipe = 'PICKUP' AND status = 'ACTIVE'" 1
expectValue "SELECT COUNT(*) FROM claims WHERE detail_claim = '$secret'" 1

sendLine $pickupCode
expectText {\[OK\] Pintu loker terbuka\.}
sendLine 1
expectText {\[OK\] Pengambilan selesai\.}
sendLine ""

# After the pickup the code is gone, the item is closed, and the log grew.
expectValue "SELECT status FROM items WHERE nama_barang = '$item'" "Sudah Diambil"
expectValue "SELECT COUNT(*) FROM access_codes" 0
expectValue "SELECT COUNT(*) FROM locker_event_logs WHERE keterangan = '$item'" 5
expectValue "SELECT COUNT(*) FROM deposits WHERE id_item = (SELECT id_item FROM items WHERE nama_barang = '$item')" 0

# A lost report is mirrored too.
sendLine 2
sendLine "Barang Hilang Mirror $suffix"
sendLine 0
sendLine 0
expectText {Barang tidak ditemukan}
sendLine 1
sendLine ""
sendLine 4
sendLine 4
sendLine [clock format [clock seconds] -format "%Y-%m-%d"]
sendLine "Hilang di gedung A"
expectText {Laporan barang hilang berhasil disimpan!}
sendLine ""
sendLine 4
expectText {MAIN MENU}

expectValue "SELECT COUNT(*) FROM lost_reports WHERE nim_pelapor = '$claimant'" 1
expectValue "SELECT status FROM lost_reports WHERE nim_pelapor = '$claimant'" "OPEN"

# The reference tables are mirrored once, and every store is readable.
expectCount users 5
expectCount categories 6
expectCount locations 8
expectCount lockers 9
expectValue "SELECT COUNT(*) FROM users WHERE email LIKE '%@tanpa-email.invalid'" 1

# Restarting keeps the text files authoritative and re-mirrors them.
close
wait
spawn sh -c "cd '$workspace' && exec '$binary'"
log_user 0
after 250
sendLine 3
expect eof
expectCount items 3
expectCount users 5
expectValue "SELECT COUNT(*) FROM items WHERE nama_barang = '$item'" 1

if {[catch {sqlAdmin "DROP DATABASE $database"}]} {
  puts stderr "Database uji $database tidak bisa dihapus."
}
puts "PASS: data .txt tercermin ke MySQL"
