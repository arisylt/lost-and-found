#!/usr/bin/expect -f
# claims.detail_claim from the RAT keeps the answer the claimant offered, so the
# admin can review it before approving or rejecting a blocked claim.
source [file join [file dirname [info script]] lib.exp]

prepareTest
startApp

set suffix [expr {[pid] % 100000}]
set finder "92$suffix"
set claimant "93$suffix"
set password "test123"
set item "Test Detail Klaim $suffix"
set secret "rahasia detail $suffix"
set workspace [newWorkspace]
startAppIn $workspace

registerStudent $finder "Penemu Detail $suffix" 1 "detail-finder-$suffix@example.test" "090$suffix" $password
loginStudent $finder $password
depositItem $item 2 1 "Barang untuk test detail" $secret 1
logoutStudent

registerStudent $claimant "Pengklaim Detail $suffix" 2 "detail-claimant-$suffix@example.test" "091$suffix" $password
loginStudent $claimant $password
for {set attempt 1} {$attempt <= 3} {incr attempt} {
  sendLine 2
  sendLine $item
  sendLine 0
  sendLine 0
  expect {
    -re [format {\[([0-9]+)\] %s} $item] { set itemNumber $expect_out(1,string) }
    timeout {
      puts stderr "Barang test tidak muncul dalam hasil pencarian."
      exit 1
    }
  }
  sendLine $itemNumber
  sendLine "jawaban salah $attempt"
  if {$attempt < 3} {
    expectText {Detail yang kamu masukkan salah\.}
  } else {
    expectText {Kamu sudah mencapai batas percobaan klaim; hubungi admin\.}
  }
  sendLine ""
}
logoutStudent
exitApp

# The admin sees the last answer the claimant submitted.
startAppIn $workspace
loginStudent admin admin123
sendLine 3
expectText {Detail  : jawaban salah 3}
sendLine 1
sendLine 2
expectText {Klaim ditolak dan dicatat\.}
sendLine ""
sendLine 6
expectText {MAIN MENU}
exitApp

# The database keeps the last answer and the rejection.
expectSql "SELECT detail_claim FROM claims" "jawaban salah 3"
expectSql "SELECT status FROM claims" "Ditolak"
expectSql "SELECT failed_count FROM claims" "0"
