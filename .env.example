# Konfigurasi database untuk Lost & Found Locker.
#
# Program membaca environment, bukan file ini. Muat dulu ke shell:
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   ./lostfound
#
# .env tidak ikut Git (lihat .gitignore), jadi kredensial asli aman di lokal.

LF_DB_HOST=127.0.0.1
LF_DB_PORT=3306
LF_DB_USER=lf
LF_DB_PASS=kata-sandi
LF_DB_NAME=lostfound
