#!/usr/bin/expect -f
# found_items.txt now also carries the deposit cycle: the keypad failure count
# (access_codes.failed_count) plus reserved_at/deposited_at/picked_up_at and the
# used_at stamps of both access codes.
source [file join [file dirname [info script]] lib.exp]

proc rowField {workspace path row field} {
  set handle [open [file join $workspace $path] r]
  set index 0
  set line ""
  while {[gets $handle current] >= 0} {
    if {$index == $row} { set line $current }
    incr index
  }
  close $handle
  if {$line == ""} { return "" }
  return [lindex [split $line "|"] $field]
}

# Fails when a stored column is empty or zero.
proc expectStamp {workspace path row field label} {
  set value [rowField $workspace $path $row $field]
  if {$value == "" || $value == 0} {
    puts stderr "$label kosong (kolom $field), seharusnya berisi waktu."
    exit 1
  }
}

# Fails when a stored column is not exactly zero.
proc expectEmptyStamp {workspace path row field label} {
  set value [rowField $workspace $path $row $field]
  if {$value != "0"} {
    puts stderr "$label berisi $value (kolom $field), seharusnya 0."
    exit 1
  }
}

prepareTest

set suffix [pid]
set finder "88$suffix"
set claimant "89$suffix"
set password "test123"
set item "Test Timestamp $suffix"
set secret "detail timestamp $suffix"
set workspace [newWorkspace]
startAppIn $workspace
set found "found_items.txt"

registerStudent $finder "Test Penemu Stempel $suffix" 1 "stamp-finder-$suffix@example.test" "098$suffix" $password
loginStudent $finder $password
depositItem $item 3 2 "Barang untuk test stempel" $secret 1

# A finished deposit keeps a reservation stamp, a drop-off stamp, and the
# used_at stamp of the deposit code. The pickup side is still empty.
set handle [open [file join $workspace $found] r]
set row -1
set index 0
while {[gets $handle line] >= 0} {
  if {[string match "*$item*" $line]} { set row $index }
  incr index
}
close $handle
if {$row < 0} {
  puts stderr "Barang $item tidak tersimpan."
  exit 1
}

expectStamp $workspace $found $row 17 "reserved_at"
expectStamp $workspace $found $row 18 "deposited_at"
expectStamp $workspace $found $row 20 "used_at kode titip"
expectEmptyStamp $workspace $found $row 16 "failed_count titip"
expectEmptyStamp $workspace $found $row 19 "picked_up_at"
expectEmptyStamp $workspace $found $row 21 "used_at kode ambil"

set storedDeposited [rowField $workspace $found $row 18]
logoutStudent
exitApp

# After a restart the stamps are read back and the item can still be claimed.
startAppIn $workspace
if {[rowField $workspace $found $row 18] != $storedDeposited} {
  puts stderr "deposited_at berubah setelah restart."
  exit 1
}

registerStudent $claimant "Test Pengklaim Stempel $suffix" 2 "stamp-claimant-$suffix@example.test" "099$suffix" $password
loginStudent $claimant $password
sendLine 2
sendLine $item
sendLine 0
sendLine 0
expect {
  -re [format {\[([0-9]+)\] %s} $item] { set itemNumber $expect_out(1,string) }
  timeout {
    puts stderr "Barang test tidak muncul setelah restart."
    exit 1
  }
}
sendLine $itemNumber
sendLine $secret
expect {
  -re {Kode ambil berlaku 24 jam: ([0-9]+)} { set pickupCode $expect_out(1,string) }
  timeout {
    puts stderr "Kode ambil tidak ditampilkan."
    exit 1
  }
}
sendLine $pickupCode
expectText {\[OK\] Pintu loker terbuka\.}
sendLine 1
expectText {\[OK\] Pengambilan selesai\. Loker kembali tersedia\.}
sendLine ""
logoutStudent
exitApp

# picked_up_at and both code stamps now describe the completed handover.
expectStamp $workspace $found $row 19 "picked_up_at"
expectStamp $workspace $found $row 20 "used_at kode titip"
expectStamp $workspace $found $row 21 "used_at kode ambil"
