#!/usr/bin/expect -f
# Text fields are limited to the RAT varchar sizes so a later database import
# cannot silently truncate or reject them.
source [file join [file dirname [info script]] lib.exp]

prepareTest
startApp

set suffix [expr {[pid] % 100000}]
set longName [string repeat "x" 101]
set nim "96$suffix"
set password "rahasia123"

# A NIM longer than varchar(15) is refused before an account is created.
sendLine 1
sendLine "1234567890123456"
sendLine "Test Panjang $suffix"
sendLine 1
sendLine "long-nim-$suffix@example.test"
sendLine "081200000001"
sendLine $password
expectText {maksimal 15}
sendLine ""

registerStudent $nim "Test Panjang $suffix" 1 "long-$suffix@example.test" "081200000002" $password
loginStudent $nim $password

# An item name longer than varchar(100) is refused and no item is stored.
sendLine 1
sendLine $longName
sendLine 1
sendLine 1
sendLine [clock format [clock seconds] -format "%Y-%m-%d"]
sendLine "Deskripsi panjang"
sendLine "rahasia panjang"
expectText {Nama barang maksimal 100 karakter}
sendLine ""

# A name at the limit is accepted.
set shortName [string repeat "y" 100]
depositItem $shortName 1 1 "Batas panjang" "rahasia batas $suffix" 1
sendLine 3
expectText $shortName
sendLine ""
logoutStudent
exitApp
